generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum HouseholdRole {
  owner
  member
}

enum RoomType {
  kitchen
  bathroom
  bedroom
  living_room
  hallway
  office
  other
}

enum Effort {
  low
  normal
  high
}

enum TaskPriority {
  low
  normal
  high
}

enum AssignmentMode {
  unassigned
  fixed
  rotation
}

enum PlanStatus {
  draft
  active
  completed
  cancelled
}

enum PlanItemStatus {
  planned
  completed
  skipped
  deferred
}

enum SelectionReason {
  overdue
  due
  priority
  manual
}

enum DevicePlatform {
  ios
  android
}

model Profile {
  id                  String                   @id @db.Uuid
  displayName         String?                  @db.VarChar(80)
  avatarUrl           String?
  locale              String                   @default("uk") @db.VarChar(20)
  timezone            String                   @default("Europe/Kyiv") @db.VarChar(100)
  onboardingCompleted Boolean                  @default(false)
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  memberships         HouseholdMember[]
  fixedTasks          Task[]                   @relation("FixedAssignee")
  completions         TaskCompletion[]
  plans               DailyPlan[]
  devices             Device[]
  notificationPrefs   NotificationPreference?
  invitationsCreated  HouseholdInvitation[]    @relation("InvitationCreator")
}

model Household {
  id          String                  @id @default(uuid()) @db.Uuid
  name        String                  @db.VarChar(80)
  timezone    String                  @db.VarChar(100)
  version     Int                     @default(1)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  members     HouseholdMember[]
  invitations HouseholdInvitation[]
  rooms       Room[]
  plans       DailyPlan[]
}

model HouseholdMember {
  id          String        @id @default(uuid()) @db.Uuid
  householdId String        @db.Uuid
  userId      String        @db.Uuid
  role        HouseholdRole
  joinedAt    DateTime      @default(now())
  household   Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user        Profile       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([householdId, userId])
  @@index([userId])
}

model HouseholdInvitation {
  id          String        @id @default(uuid()) @db.Uuid
  householdId String        @db.Uuid
  createdById String        @db.Uuid
  tokenHash   String        @unique
  role        HouseholdRole @default(member)
  email       String?
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime      @default(now())
  household   Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdBy   Profile       @relation("InvitationCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([householdId])
}

model Room {
  id          String    @id @default(uuid()) @db.Uuid
  householdId String    @db.Uuid
  name        String    @db.VarChar(80)
  type        RoomType
  position    Int       @default(0)
  archived    Boolean   @default(false)
  version     Int       @default(1)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  tasks       Task[]

  @@index([householdId, archived, position])
}

model TaskTemplate {
  id               String       @id @default(uuid()) @db.Uuid
  slug             String       @unique
  title            String       @db.VarChar(120)
  roomType         RoomType
  estimatedMinutes Int
  effort           Effort
  priority         TaskPriority @default(normal)
  recurrence       Json
  enabled          Boolean      @default(true)
  createdAt        DateTime     @default(now())
  tasks            Task[]
}

model Task {
  id                String          @id @default(uuid()) @db.Uuid
  roomId            String          @db.Uuid
  templateId        String?         @db.Uuid
  title             String          @db.VarChar(120)
  notes             String?
  estimatedMinutes  Int
  effort            Effort
  priority          TaskPriority
  recurrence        Json
  nextDueOn         DateTime?       @db.Date
  lastCompletedAt   DateTime?
  assignmentMode    AssignmentMode  @default(unassigned)
  fixedAssigneeId   String?         @db.Uuid
  rotationMemberIds String[]        @db.Uuid
  archived          Boolean         @default(false)
  version           Int             @default(1)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  room              Room            @relation(fields: [roomId], references: [id], onDelete: Cascade)
  template          TaskTemplate?   @relation(fields: [templateId], references: [id], onDelete: SetNull)
  fixedAssignee     Profile?        @relation("FixedAssignee", fields: [fixedAssigneeId], references: [id], onDelete: SetNull)
  completions       TaskCompletion[]
  planItems         DailyPlanItem[]

  @@index([roomId, archived])
  @@index([nextDueOn])
}

model TaskCompletion {
  id             String   @id @default(uuid()) @db.Uuid
  taskId         String   @db.Uuid
  completedById  String   @db.Uuid
  completedAt    DateTime @default(now())
  actualMinutes  Int?
  note           String?
  undoneAt       DateTime?
  idempotencyKey String   @db.VarChar(100)
  createdAt      DateTime @default(now())
  task           Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  completedBy    Profile  @relation(fields: [completedById], references: [id], onDelete: Restrict)

  @@unique([taskId, idempotencyKey])
  @@index([completedById, completedAt])
}

model DailyPlan {
  id                String          @id @default(uuid()) @db.Uuid
  householdId       String          @db.Uuid
  userId            String          @db.Uuid
  localDate         DateTime        @db.Date
  timezone          String          @db.VarChar(100)
  timeBudgetMinutes Int
  energyLevel       Effort
  status            PlanStatus      @default(active)
  version           Int             @default(1)
  idempotencyKey    String          @db.VarChar(100)
  scheduledStartAt  DateTime?
  scheduledEndAt    DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  household         Household       @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user              Profile         @relation(fields: [userId], references: [id], onDelete: Cascade)
  items             DailyPlanItem[]

  @@unique([householdId, userId, localDate])
  @@unique([userId, idempotencyKey])
  @@index([householdId, localDate])
}

model DailyPlanItem {
  id               String           @id @default(uuid()) @db.Uuid
  planId           String           @db.Uuid
  taskId           String           @db.Uuid
  position         Int
  estimatedMinutes Int
  reason           SelectionReason
  status           PlanItemStatus   @default(planned)
  scheduledStartAt DateTime?
  scheduledEndAt   DateTime?
  version          Int              @default(1)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  plan             DailyPlan        @relation(fields: [planId], references: [id], onDelete: Cascade)
  task             Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([planId, taskId])
  @@index([planId, position])
}

model Device {
  id             String         @id @default(uuid()) @db.Uuid
  userId         String         @db.Uuid
  installationId String         @db.VarChar(120)
  platform       DevicePlatform
  expoPushToken  String?
  locale         String         @db.VarChar(20)
  timezone       String         @db.VarChar(100)
  appVersion     String?        @db.VarChar(30)
  notificationsEnabled Boolean  @default(false)
  lastSeenAt     DateTime       @default(now())
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  user           Profile        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, installationId])
}

model NotificationPreference {
  userId            String   @id @db.Uuid
  dailyPlanEnabled  Boolean  @default(true)
  assignmentEnabled Boolean  @default(true)
  invitationEnabled Boolean  @default(true)
  quietHoursStart   String?  @db.VarChar(5)
  quietHoursEnd     String?  @db.VarChar(5)
  updatedAt         DateTime @updatedAt
  user              Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
}
